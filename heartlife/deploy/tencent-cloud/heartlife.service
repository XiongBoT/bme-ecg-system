[Unit]
Description=HeartLife Companion Health Platform (FastAPI + Vue SPA)
After=network.target

[Service]
Type=simple
WorkingDirectory=__APP_DIR__/backend
EnvironmentFile=__ENV_FILE__
ExecStart=__APP_DIR__/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
